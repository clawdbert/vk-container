VK_INSTANCE=project
PORT=3927
BACKEND_PORT=3930
HOST=0.0.0.0
NODE_ENV=development
HOME=/home/deploy
VK_CONTAINER_NAME=vk-project
VK_SHARE_VOL=vk-project-share
VK_HOME_VOL=vk-project-home
